# Porta del backend locale
PORT=3001

# Crea una chiave su https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Crea una chiave su https://ecofreight.co/ per attivare il calcolo live.
ECOFREIGHT_API_KEY=

# URL di connessione PostgreSQL di Supabase per la memoria online.
# In locale, se è vuota, Orizon usa il database SQLite in data/orizon.db.
DATABASE_URL=
